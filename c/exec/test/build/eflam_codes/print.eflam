# A basic Mealy machine that accepts `print("STRING")` codes.


$0$ {'S','A'} |
    (' ','\n','\t')$0$ ['ALPHA'],
    ('print')$1$ ['BETA'],
    (@)$-1$ ['ERROR-1'];


$1$ |
    (' ','\t')$1$ ['CHARLIE'],
    ('(')$2$ ['DELTA'],
    (@)$-2$ ['ERROR-2'];


$2$ |
    (' ','\t')$2$ ['ECHO'],
    ('"')$3$ ['FOXTROT'],
    (@)$-3$ ['ERROR-3'];


$3$ |
    ('"')$4$ ['GOLF'],
    (@)$3$ ['HOTEL'];


$4$ |
    (' ','\t')$4$ ['INDIA'],
    (')')$5$ ['PRINT_STR'],
    (@)$-4$ ['JULIETTE'];


$5$ {'A'} |
    ('\n')$0$ ['KILO'],
    (' ','\t')$5$ ['LIMMA'],
    (@)$-5$ ['ERROR-5'];

