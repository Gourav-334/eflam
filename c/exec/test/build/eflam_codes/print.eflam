# A basic Mealy machine that accepts `print("STRING")` codes.


$0$ {'S','A'} |
    (' ','\n','\t')$0$ ['NULL'],
    ('print')$1$ ['NULL'],
    (@)$-1$ ['ERROR-1'];


$1$ |
    (' ','\t')$1$ ['NULL'],
    ('(')$2$ ['NULL'],
    (@)$-2$ ['ERROR-2'];


$2$ |
    (' ','\t')$2$ ['NULL'],
    ('"')$3$ ['NULL'],
    (@)$-3$ ['ERROR-3'];


$3$ |
    ('"')$4$ ['NULL'],
    (@)$3$ ['NULL'];


$4$ |
    (' ','\t')$4$ ['NULL'],
    (')')$5$ ['PRINT_STR'],
    (@)$-4$ ['ERROR-4'];


$5$ {'A'} |
    ('\n')$0$ ['NULL'],
    (' ','\t')$5$ ['NULL'],
    (@)$-5$ ['ERROR-5'];

