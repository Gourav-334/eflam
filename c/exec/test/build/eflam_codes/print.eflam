# A basic Moore machine that accepts `print("STRING")` codes.

$0$ ['NULL'] {'S','A'} | (' ','\n','\t')$0$, ('print')$1$, (@)$-1$;
$1$ ['PRINT'] | (' ','\t')$1$, ('(')$2$, (@)$-2$;
$2$ ['BRACK_OPEN'] | (' ','\t')$2$, ('"')$3$, (@)$-3$;
$3$ ['STR_OPEN'] | ('"')$4$, (@)$3$;
$4$ ['STR_CLOSE'] | (' ','\t')$4$, (')')$5$, (@)$-4$;
$5$ ['BRACK_CLOSE'] {'A'} | ('\n')$0$, (' ','\t')$5$, (@)$-5$;
$-1$ ['ERROR-1'];
$-2$ ['ERROR-2'];
$-3$ ['ERROR-3'];
$-4$ ['ERROR-4'];
$-5$ ['ERROR-5'];
